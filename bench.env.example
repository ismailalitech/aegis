# SPDX-License-Identifier: Apache-2.0
# Copy to bench.env (git-ignored) and fill in your bench. Documentation addresses shown.
GATEWAY=192.0.2.10          # the PolarFire gateway (ssh as root, key auth)
STM32=192.0.2.20:7444       # the STM32 prover's line-protocol endpoint (the demo board)
STM32_SN=<ST-LINK serial>   # its ST-LINK serial number: STM32_Programmer_CLI -l st
STM32_2=192.0.2.21:7444     # optional: a second STM32 endpoint
STM32_2_SN=<ST-LINK serial> # and its ST-LINK serial
RW612=192.0.2.22:7444       # optional: the FRDM-RW612 prover (docs/pc-verifier.md)
PFDAQ_ROOT=$HOME/pfdaq      # checkout of the pfdaq repository (hw/libero/build.sh)
AEGIS_REPO=$HOME/aegis      # this checkout (yocto/aegis-kernel.conf)
REDTEAM_STM32=          # optional: the STM32 the device red-team attacks (default: STM32)
