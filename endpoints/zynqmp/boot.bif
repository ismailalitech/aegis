// bootgen -arch zynqmp -image boot.bif -o BOOT.BIN -w
// FSBL and PMU firmware from Vitis 2025.2 (XSA: te0807_4eg_1e_tebf0808, PS only); bitstream from Vivado 2025.2;
// OP-TEE goes in as tee-raw.bin, not tee.elf: the raw image carries init data that the ELF lacks (the ELF fails at
// start-up with an alignment fault in copy_init). TF-A (SPD=opteed), OP-TEE 4.7 with the Aegis TA built in (EARLY_TA_PATHS) and U-Boot, built on Linux.
the_ROM_image:
{
	[bootloader, destination_cpu=a53-0] fsbl.elf
	[pmufw_image] pmufw.elf
	[destination_device=pl] system.bit
	[destination_cpu=a53-0, exception_level=el-3, trustzone] bl31.elf
	[destination_cpu=a53-0, exception_level=el-1, trustzone, load=0x60000000, startup=0x60000000] tee-raw.bin
	[destination_cpu=a53-0, exception_level=el-2] u-boot.elf
}
