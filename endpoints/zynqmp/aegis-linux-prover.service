[Unit]
Description=Aegis prover (Zynq UltraScale+ Linux endpoint, software trust), TCP 7444
After=network-online.target boot-firmware.mount
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/aegis-prover/aegis_linux_prover.py --state /var/lib/aegis-prover \
    --gateway-pk /etc/aegis-prover/gateway.mldsa65.pub \
    --measure BOOT=/boot/firmware/BOOT.BIN \
    --measure KERNEL=/boot/firmware/Image,/boot/firmware/zynqmp-te0807-aegis.dtb,/boot/firmware/boot.scr
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
