CONFIG_DEFAULT_DEVICE_TREE="zynqmp-te0807-aegis"
CONFIG_OF_LIST="zynqmp-te0807-aegis"
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_NAND is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="mmc dev 0 && fatload mmc 0:1 0x20000000 boot.scr && source 0x20000000"
CONFIG_BOOTDELAY=2
