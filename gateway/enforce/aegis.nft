#!/usr/sbin/nft -f
# SPDX-License-Identifier: Apache-2.0
# Aegis zero-trust enforcement on the gateway (needs a kernel with nf_tables: aegis-netfilter.cfg).
# The gateway must sit in the traffic path: endpoints behind a second port or on a quarantine VLAN,
# the gateway routing between that segment ($ENDPOINT_IF) and the rest of the network.
# Policy: an endpoint may forward traffic only while its address is in @admitted. Attestation
# itself always works (the gateway connects to the endpoints; DHCP is allowed).
# Loaded by aegis-enforce.sh init; the set is filled by fleet.py via aegis-enforce.sh admit|quarantine.
table inet aegis
delete table inet aegis
table inet aegis {
    # Admissions expire: fleet.py refreshes each admitted endpoint every cycle with a timeout it derives from its
    # re-attestation interval (AEGIS_ADMIT_TTL, fleet.admit_ttl), so if the fleet loop stops, the endpoints drop out
    # instead of staying admitted forever. The default here applies only to elements added by hand.
    set admitted {
        type ipv4_addr
        flags timeout
        timeout 5m
        comment "endpoints that passed attestation in the last cycle"
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        # Both directions are accepted only for an admitted endpoint, new or established, so quarantine also cuts
        # connections that were already open (a blanket "ct state established accept" would let them live on).
        iifname $ENDPOINT_IF ip saddr @admitted accept
        oifname $ENDPOINT_IF ip daddr @admitted accept
        iifname $ENDPOINT_IF counter log prefix "aegis-quarantine " limit rate 5/second drop
    }
    chain input {
        type filter hook input priority filter; policy accept;
        iifname $ENDPOINT_IF udp dport 67 accept comment "DHCP for endpoints"
        # Replies to connections the gateway opened (attestation, provisioning, heartbeats): without this the next
        # rule dropped them, so a non-admitted endpoint could never be attested, and never admitted. Connections an
        # endpoint opens are in the original direction and still go through the rules below.
        iifname $ENDPOINT_IF ct direction reply accept comment "replies to the gateway's own connections"
        iifname $ENDPOINT_IF ip saddr != @admitted tcp dport != { 7443 } counter drop comment "quarantined: nothing but the quote service"
    }
}
